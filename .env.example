# ---------------------------------------------------------------------------
# RMPAC application configuration
#
# Copy to `.env` for local development. Never commit a filled-in copy.
# Every value below is read through `src/lib/config.ts`, which validates the
# whole environment once at startup and fails fast with a readable message.
# ---------------------------------------------------------------------------

# --- Required everywhere ---------------------------------------------------

# PostgreSQL connection string. On Render, bind this to the managed database's
# internal connection string rather than pasting a literal value.
DATABASE_URL="postgresql://localhost:5432/rmpac_dev"

# Absolute public origin of the deployment, no trailing slash. Used for
# same-origin/CSRF checks, canonical URLs and the web app manifest.
# Changing the custom domain means changing this value and the Render domain
# settings only — no code change and no rebuild of application logic.
APP_ORIGIN="http://localhost:3000"

# Secret used to derive CSRF tokens and sign short-lived admin reset tokens.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
# Rotating it invalidates outstanding CSRF tokens and password-reset links.
SESSION_SECRET="dev-only-session-secret-change-me-before-production-use"

# The club's JustGiving fundraising page. The application only ever links out
# to this URL in a new tab; it never processes payments or reads donation data.
# Production refuses to start unless this is a real https://www.justgiving.com
# URL — the development placeholder is rejected.
JUSTGIVING_URL="https://www.justgiving.com/page/example-placeholder"

# --- Optional public copy --------------------------------------------------
# Plain text. Leave unset to use the built-in defaults.
CLUB_WELCOME_COPY=""
FUNDRAISING_COPY=""

# --- First administrator bootstrap ----------------------------------------
# Used only by `npm run bootstrap:admin`. Set these as one-time environment
# variables, run the command once, then remove them from the environment.
# The command is idempotent and never overwrites an existing account unless
# BOOTSTRAP_ADMIN_RESET=true is set explicitly.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_RESET="false"

# --- Runtime behaviour -----------------------------------------------------
# `development` | `test` | `production`. Next.js sets this; override only in
# scripts. Production mode enables strict configuration checks.
# NODE_ENV="development"

# Set to "true" to allow the sample-data seed to run. It is refused in
# production regardless of this flag.
ALLOW_SAMPLE_SEED="false"

# Optional log level: debug | info | warn | error. Defaults to info.
LOG_LEVEL="info"
