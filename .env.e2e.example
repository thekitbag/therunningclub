# Configuration for the Playwright browser suite.
#
# These run the REAL production build (`next build` + `next start`), so the
# values here satisfy every production rule. The origin is loopback, which the
# configuration validator exempts from the https requirement because a browser
# already treats loopback as a secure context.
DATABASE_URL="postgresql://localhost:5432/rmpac_test"
APP_ORIGIN="http://127.0.0.1:3100"
SESSION_SECRET="e2e-only-session-secret-well-over-thirty-two-characters"
JUSTGIVING_URL="https://www.justgiving.com/page/rmpac-e2e-fixture"
LOG_LEVEL="error"
