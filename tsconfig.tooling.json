{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/__tests__/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "prisma.config.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}
