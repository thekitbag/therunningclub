# Configuration for the integration test suite.
# Copy to `.env.test`. The database is truncated between tests — never point
# this at a database containing real data.
DATABASE_URL="postgresql://localhost:5432/rmpac_test"
APP_ORIGIN="http://localhost:3000"
SESSION_SECRET="test-only-session-secret-not-used-in-any-real-deployment"
JUSTGIVING_URL="https://www.justgiving.com/page/example-placeholder"
NODE_ENV="test"
ALLOW_SAMPLE_SEED="true"
LOG_LEVEL="error"

# Integration tests exercise the services directly, below the gate.
SITE_PASSCODE=""
